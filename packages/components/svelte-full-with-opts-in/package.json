{
  "name": "@file-viewer/svelte-full-with-opts-in",
  "version": "3.1.2",
  "private": false,
  "type": "module",
  "description": "svelte File Viewer full-with-opts-in package: all supported opt-ins enabled, AGPL CAD runtime excluded.",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/components/svelte-full-with-opts-in"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/FileViewer.svelte.d.ts",
      "svelte": "./src/FileViewer.svelte",
      "import": "./src/FileViewer.svelte",
      "default": "./src/FileViewer.svelte"
    },
    "./action": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./controller": {
      "types": "./dist/controller.d.ts",
      "import": "./dist/controller.js",
      "default": "./dist/controller.js"
    },
    "./types": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/FileViewer.svelte",
    "src/FileViewer.svelte.d.ts",
    "src/controller.ts",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "type-check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@file-viewer/preset-full-with-opts-in": "workspace:3.1.2",
    "@file-viewer/svelte": "workspace:3.1.2"
  },
  "peerDependencies": {
    "svelte": ">=3.59 <6"
  },
  "devDependencies": {
    "svelte": "^5.57.0",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0"
}
